<?xml version="1.0" encoding="UTF-8"?>
<actions>
  <!-- One-click Run in NetBeans uses the JavaFX plugin (correct module path)
       instead of the default exec plugin. Working directory comes from the
       pom's javafx-maven-plugin configuration (parent folder with rules/). -->
  <action>
    <actionName>run</actionName>
    <goals>
      <goal>org.openjfx:javafx-maven-plugin:0.0.8:run</goal>
    </goals>
  </action>
</actions>
